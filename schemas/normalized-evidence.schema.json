{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://velari.local/schemas/normalized-evidence.schema.json",
  "title": "Velari Normalized Evidence Item",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "schema_version",
    "evidence_id",
    "title",
    "plain_english_summary",
    "why_it_matters",
    "source_system",
    "source_type",
    "collected_at",
    "phi_expected",
    "phi_status",
    "control_area",
    "subject",
    "summary",
    "status",
    "confidence",
    "confidence_score",
    "confidence_reason",
    "counts",
    "observations",
    "owner_lane",
    "recommended_question",
    "acceptable_evidence",
    "unsafe_inputs",
    "unsafe_fields_excluded",
    "unsafe_inputs_excluded",
    "next_action",
    "recommended_action",
    "timeframe",
    "reviewer_needed",
    "owner_view",
    "msp_view",
    "vendor_view",
    "legal_compliance_view",
    "technical_reviewer_view",
    "stage_id",
    "priority",
    "source_refs",
    "notes"
  ],
  "properties": {
    "schema_version": {
      "const": "2026-05-19"
    },
    "evidence_id": {
      "type": "string",
      "pattern": "^CONN-[A-Z0-9-]+-[0-9]{3}$"
    },
    "title": {
      "type": "string",
      "minLength": 1
    },
    "plain_english_summary": {
      "type": "string",
      "minLength": 1
    },
    "why_it_matters": {
      "type": "string",
      "minLength": 1
    },
    "source_system": {
      "type": "string",
      "minLength": 1
    },
    "source_type": {
      "enum": [
        "csv_import",
        "dns_lookup",
        "public_lookup",
        "api_read_only",
        "msp_response",
        "msp_export",
        "client_export"
      ]
    },
    "collected_at": {
      "type": "string",
      "format": "date-time"
    },
    "phi_expected": {
      "const": false
    },
    "phi_status": {
      "const": "metadata_only_no_phi_expected"
    },
    "control_area": {
      "type": "string",
      "minLength": 1
    },
    "subject": {
      "type": "string",
      "minLength": 1
    },
    "summary": {
      "type": "string",
      "minLength": 1
    },
    "status": {
      "enum": [
        "observed",
        "current",
        "missing",
        "stale",
        "needs_review",
        "requested",
        "not_applicable"
      ]
    },
    "confidence": {
      "enum": [
        "observed_from_public_dns",
        "observed_from_public_web",
        "observed_from_api",
        "imported_from_msp_response",
        "imported_from_client_export",
        "imported_from_msp_export",
        "self_attested",
        "derived_from_packet",
        "unknown"
      ]
    },
    "confidence_score": {
      "type": "integer",
      "minimum": 0,
      "maximum": 100
    },
    "confidence_reason": {
      "type": "string",
      "minLength": 1
    },
    "counts": {
      "type": "object",
      "additionalProperties": {
        "type": [
          "integer",
          "number",
          "string",
          "boolean"
        ]
      }
    },
    "observations": {
      "type": "object",
      "additionalProperties": true
    },
    "owner_lane": {
      "enum": [
        "owner",
        "office_manager",
        "msp",
        "vendor",
        "legal_compliance",
        "insurer",
        "clinical_lead",
        "velari_reviewer",
        "incident_responder"
      ]
    },
    "recommended_question": {
      "type": "string",
      "minLength": 1
    },
    "acceptable_evidence": {
      "type": "array",
      "minItems": 1,
      "items": {
        "type": "string",
        "minLength": 1
      }
    },
    "unsafe_inputs": {
      "type": "array",
      "minItems": 1,
      "items": {
        "type": "string",
        "minLength": 1
      }
    },
    "unsafe_fields_excluded": {
      "type": "array",
      "minItems": 1,
      "items": {
        "type": "string",
        "minLength": 1
      }
    },
    "unsafe_inputs_excluded": {
      "type": "array",
      "minItems": 1,
      "items": {
        "type": "string",
        "minLength": 1
      }
    },
    "next_action": {
      "type": "string",
      "minLength": 1
    },
    "recommended_action": {
      "type": "string",
      "minLength": 1
    },
    "timeframe": {
      "enum": [
        "this_week",
        "30_days",
        "60_days",
        "90_days",
        "quarterly_refresh"
      ]
    },
    "reviewer_needed": {
      "type": "array",
      "minItems": 1,
      "items": {
        "enum": [
          "owner",
          "office_manager",
          "msp",
          "vendor_owner",
          "legal_or_compliance_reviewer",
          "technical_reviewer",
          "clinical_lead",
          "velari_reviewer",
          "incident_responder"
        ]
      }
    },
    "owner_view": {
      "type": "string",
      "minLength": 1
    },
    "msp_view": {
      "type": "string",
      "minLength": 1
    },
    "vendor_view": {
      "type": "string",
      "minLength": 1
    },
    "legal_compliance_view": {
      "type": "string",
      "minLength": 1
    },
    "technical_reviewer_view": {
      "type": "string",
      "minLength": 1
    },
    "stage_id": {
      "enum": [
        "intake",
        "patient_data_outside_ehr_map",
        "ai_phi_review",
        "vendor_baa_review",
        "access_offboarding_review",
        "downtime_ransomware_review",
        "findings_risk_register",
        "evidence_packet_export",
        "owner_msp_handoff"
      ]
    },
    "priority": {
      "enum": [
        "critical",
        "high",
        "medium",
        "low"
      ]
    },
    "source_refs": {
      "type": "array",
      "items": {
        "type": "string"
      }
    },
    "notes": {
      "type": "string"
    }
  }
}
