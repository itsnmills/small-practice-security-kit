{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://velari.local/schemas/velari-answer-standard.schema.json",
  "title": "Velari Answer Standard Action Packet",
  "type": "object",
  "additionalProperties": true,
  "required": [
    "finding_id",
    "title",
    "plain_english_summary",
    "why_it_matters",
    "owner_lane",
    "recommended_question",
    "acceptable_evidence",
    "unsafe_inputs",
    "priority",
    "timeframe",
    "reviewer_needed",
    "next_action"
  ],
  "properties": {
    "finding_id": {
      "type": "string",
      "minLength": 1
    },
    "title": {
      "type": "string",
      "minLength": 1
    },
    "plain_english_summary": {
      "type": "string",
      "minLength": 1
    },
    "why_it_matters": {
      "type": "string",
      "minLength": 1
    },
    "risk_area": {
      "type": "string",
      "minLength": 1
    },
    "affected_workflows": {
      "type": "array",
      "items": {
        "type": "string",
        "minLength": 1
      }
    },
    "owner_lane": {
      "enum": [
        "owner",
        "office_manager",
        "msp",
        "vendor",
        "legal_compliance",
        "insurer",
        "clinical_lead",
        "velari_reviewer",
        "incident_responder"
      ]
    },
    "secondary_owner_lane": {
      "enum": [
        "owner",
        "office_manager",
        "msp",
        "vendor",
        "legal_compliance",
        "insurer",
        "clinical_lead",
        "velari_reviewer",
        "incident_responder"
      ]
    },
    "recommended_question": {
      "type": "string",
      "minLength": 1
    },
    "acceptable_evidence": {
      "type": "array",
      "minItems": 1,
      "items": {
        "type": "string",
        "minLength": 1
      }
    },
    "unsafe_inputs": {
      "type": "array",
      "minItems": 1,
      "items": {
        "type": "string",
        "minLength": 1
      }
    },
    "priority": {
      "enum": [
        "critical",
        "high",
        "medium",
        "low"
      ]
    },
    "timeframe": {
      "enum": [
        "this_week",
        "30_days",
        "60_days",
        "90_days",
        "quarterly_refresh"
      ]
    },
    "reviewer_needed": {
      "type": "array",
      "minItems": 1,
      "items": {
        "enum": [
          "owner",
          "office_manager",
          "msp",
          "vendor_owner",
          "legal_or_compliance_reviewer",
          "technical_reviewer",
          "clinical_lead",
          "velari_reviewer",
          "incident_responder"
        ]
      }
    },
    "next_action": {
      "type": "string",
      "minLength": 1
    },
    "service_context": {
      "type": "string"
    },
    "output_views": {
      "$ref": "#/$defs/output_views"
    },
    "owner_view": {
      "type": "string"
    },
    "msp_view": {
      "type": "string"
    },
    "vendor_view": {
      "type": "string"
    },
    "legal_compliance_view": {
      "type": "string"
    },
    "technical_reviewer_view": {
      "type": "string"
    }
  },
  "$defs": {
    "output_views": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "owner_summary",
        "msp_task",
        "vendor_question",
        "legal_compliance_note",
        "technical_reviewer_note"
      ],
      "properties": {
        "owner_summary": {
          "type": "string"
        },
        "msp_task": {
          "type": "string"
        },
        "vendor_question": {
          "type": "string"
        },
        "legal_compliance_note": {
          "type": "string"
        },
        "technical_reviewer_note": {
          "type": "string"
        }
      }
    }
  }
}
