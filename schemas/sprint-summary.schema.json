{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://velari.local/schemas/sprint-summary.schema.json",
  "title": "Velari Sprint Mode Summary",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "schema_version",
    "sprint_id",
    "generated_at",
    "generator",
    "source_profile",
    "practice",
    "overall_risk",
    "readiness_signal",
    "target_delivery_signal",
    "data_boundary",
    "stage_statuses",
    "top_risks",
    "evidence_gap_summary",
    "handoff_lanes",
    "connector_evidence_summary",
    "control_evidence_summary",
    "offering_summary",
    "counts",
    "outputs",
    "contract_artifacts",
    "limitations"
  ],
  "properties": {
    "schema_version": {
      "const": "2026-05-19"
    },
    "sprint_id": {
      "type": "string",
      "pattern": "^sprint_[a-z0-9_]+$"
    },
    "generated_at": {
      "type": "string",
      "format": "date-time"
    },
    "generator": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "name",
        "mode"
      ],
      "properties": {
        "name": {
          "const": "small-practice-security-kit"
        },
        "mode": {
          "const": "velari_sprint_mode_public_runner"
        }
      }
    },
    "source_profile": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "path",
        "sha256",
        "input_path"
      ],
      "properties": {
        "path": {
          "type": "string",
          "pattern": "^(?!/)(?!.*(?:^|/)\\.\\.(?:/|$))[^\\\\\\u0000]+$"
        },
        "sha256": {
          "type": "string",
          "pattern": "^[a-f0-9]{64}$"
        },
        "input_path": {
          "type": "string",
          "pattern": "^(?!/)(?!.*(?:^|/)\\.\\.(?:/|$))[^\\\\\\u0000]+$"
        }
      }
    },
    "practice": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "label",
        "type",
        "review_period",
        "staff_count",
        "locations"
      ],
      "properties": {
        "label": {
          "type": "string"
        },
        "type": {
          "type": "string"
        },
        "review_period": {
          "type": "string"
        },
        "staff_count": {
          "type": "integer"
        },
        "locations": {
          "type": "integer"
        }
      }
    },
    "overall_risk": {
      "enum": [
        "low",
        "medium",
        "high"
      ]
    },
    "readiness_signal": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "label",
        "meaning",
        "high_or_critical_findings",
        "stages_needing_evidence"
      ],
      "properties": {
        "label": {
          "enum": [
            "low",
            "medium",
            "high"
          ]
        },
        "meaning": {
          "type": "string"
        },
        "high_or_critical_findings": {
          "type": "integer",
          "minimum": 0
        },
        "stages_needing_evidence": {
          "type": "integer",
          "minimum": 0
        }
      }
    },
    "target_delivery_signal": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "status",
        "primary_blocker",
        "next_artifact"
      ],
      "properties": {
        "status": {
          "enum": [
            "needs_evidence_before_closeout",
            "ready_for_client_readout"
          ]
        },
        "primary_blocker": {
          "type": "string"
        },
        "next_artifact": {
          "const": "sprint-command-center.html"
        }
      }
    },
    "data_boundary": {
      "$ref": "#/$defs/data_boundary"
    },
    "stage_statuses": {
      "type": "array",
      "minItems": 9,
      "maxItems": 9,
      "items": {
        "$ref": "#/$defs/stage"
      }
    },
    "top_risks": {
      "type": "array",
      "items": {
        "$ref": "#/$defs/risk"
      }
    },
    "evidence_gap_summary": {
      "$ref": "#/$defs/evidence_gap_summary"
    },
    "handoff_lanes": {
      "type": "array",
      "items": {
        "$ref": "#/$defs/handoff_lane"
      }
    },
    "offering_summary": {
      "$ref": "#/$defs/offering_summary"
    },
    "counts": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "stages",
        "stages_needing_evidence",
        "findings",
        "high_or_critical_findings",
        "evidence_references",
        "handoff_actions",
        "connector_evidence_items",
        "control_evidence_rows",
        "control_evidence_needing_attention"
      ],
      "properties": {
        "stages": {
          "const": 9
        },
        "stages_needing_evidence": {
          "type": "integer",
          "minimum": 0
        },
        "findings": {
          "type": "integer",
          "minimum": 0
        },
        "high_or_critical_findings": {
          "type": "integer",
          "minimum": 0
        },
        "evidence_references": {
          "type": "integer",
          "minimum": 0
        },
        "handoff_actions": {
          "type": "integer",
          "minimum": 0
        },
        "connector_evidence_items": {
          "type": "integer",
          "minimum": 0
        },
        "control_evidence_rows": {
          "type": "integer",
          "minimum": 0
        },
        "control_evidence_needing_attention": {
          "type": "integer",
          "minimum": 0
        }
      }
    },
    "outputs": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "sprint",
        "packet",
        "binder_export"
      ],
      "properties": {
        "sprint": {
          "type": "array",
          "contains": {
            "const": "sprint-command-center.html"
          },
          "items": {
            "type": "string"
          }
        },
        "packet": {
          "type": "array",
          "items": {
            "type": "string"
          }
        },
        "binder_export": {
          "const": "evidence-binder-export/"
        }
      }
    },
    "contract_artifacts": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "answer_standard_schema",
        "normalized_evidence_schema",
        "connector_run_schema",
        "sprint_summary_schema",
        "evidence_index_schema",
        "private_app_import_hint",
        "control_evidence_matrix_schema"
      ],
      "properties": {
        "answer_standard_schema": {
          "const": "schemas/velari-answer-standard.schema.json"
        },
        "normalized_evidence_schema": {
          "const": "schemas/normalized-evidence.schema.json"
        },
        "connector_run_schema": {
          "const": "schemas/connector-run.schema.json"
        },
        "sprint_summary_schema": {
          "const": "schemas/sprint-summary.schema.json"
        },
        "evidence_index_schema": {
          "const": "schemas/evidence-index.schema.json"
        },
        "private_app_import_hint": {
          "type": "string"
        },
        "control_evidence_matrix_schema": {
          "const": "schemas/control-evidence-matrix.schema.json"
        }
      }
    },
    "limitations": {
      "type": "array",
      "minItems": 1,
      "items": {
        "type": "string"
      }
    },
    "control_evidence_summary": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "total_controls",
        "mapped_controls",
        "linked_answer_packets",
        "by_evidence_status",
        "by_freshness_status",
        "needs_attention",
        "by_owner_needing_attention"
      ],
      "properties": {
        "total_controls": {
          "type": "integer",
          "minimum": 1
        },
        "mapped_controls": {
          "type": "integer",
          "minimum": 0
        },
        "linked_answer_packets": {
          "type": "array",
          "items": {
            "type": "string"
          }
        },
        "by_evidence_status": {
          "type": "object",
          "additionalProperties": {
            "type": "integer",
            "minimum": 0
          }
        },
        "by_freshness_status": {
          "type": "object",
          "additionalProperties": {
            "type": "integer",
            "minimum": 0
          }
        },
        "needs_attention": {
          "type": "integer",
          "minimum": 0
        },
        "by_owner_needing_attention": {
          "type": "object",
          "additionalProperties": {
            "type": "integer",
            "minimum": 0
          }
        }
      }
    },
    "connector_evidence_summary": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "total_items",
        "runs",
        "by_connector",
        "by_status",
        "by_confidence",
        "by_owner_lane",
        "by_control_area",
        "needs_attention",
        "data_boundary"
      ],
      "properties": {
        "total_items": {
          "type": "integer",
          "minimum": 0
        },
        "runs": {
          "type": "array",
          "items": {
            "type": "object",
            "additionalProperties": false,
            "required": [
              "run_id",
              "connector",
              "mode",
              "status",
              "input_ref",
              "evidence_count",
              "phi_expected",
              "warnings"
            ],
            "properties": {
              "run_id": {
                "type": "string"
              },
              "connector": {
                "type": "string"
              },
              "mode": {
                "type": "string"
              },
              "status": {
                "type": "string"
              },
              "input_ref": {
                "type": "string"
              },
              "evidence_count": {
                "type": "integer",
                "minimum": 0
              },
              "phi_expected": {
                "const": false
              },
              "warnings": {
                "type": "array",
                "items": {
                  "type": "string"
                }
              }
            }
          }
        },
        "by_connector": {
          "type": "object",
          "additionalProperties": {
            "type": "integer",
            "minimum": 0
          }
        },
        "by_status": {
          "type": "object",
          "additionalProperties": {
            "type": "integer",
            "minimum": 0
          }
        },
        "by_confidence": {
          "type": "object",
          "additionalProperties": {
            "type": "integer",
            "minimum": 0
          }
        },
        "by_owner_lane": {
          "type": "object",
          "additionalProperties": {
            "type": "integer",
            "minimum": 0
          }
        },
        "by_control_area": {
          "type": "object",
          "additionalProperties": {
            "type": "integer",
            "minimum": 0
          }
        },
        "needs_attention": {
          "type": "integer",
          "minimum": 0
        },
        "data_boundary": {
          "const": "metadata_only_no_phi_expected"
        }
      }
    }
  },
  "$defs": {
    "owner_lane": {
      "enum": [
        "owner",
        "office_manager",
        "msp",
        "vendor",
        "legal_compliance",
        "insurer",
        "clinical_lead",
        "velari_reviewer",
        "incident_responder"
      ]
    },
    "timeframe": {
      "enum": [
        "this_week",
        "30_days",
        "60_days",
        "90_days",
        "quarterly_refresh"
      ]
    },
    "reviewer_needed": {
      "type": "array",
      "minItems": 1,
      "items": {
        "enum": [
          "owner",
          "office_manager",
          "msp",
          "vendor_owner",
          "legal_or_compliance_reviewer",
          "technical_reviewer",
          "clinical_lead",
          "velari_reviewer",
          "incident_responder"
        ]
      }
    },
    "output_views": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "owner_summary",
        "msp_task",
        "vendor_question",
        "legal_compliance_note",
        "technical_reviewer_note"
      ],
      "properties": {
        "owner_summary": {
          "type": "string"
        },
        "msp_task": {
          "type": "string"
        },
        "vendor_question": {
          "type": "string"
        },
        "legal_compliance_note": {
          "type": "string"
        },
        "technical_reviewer_note": {
          "type": "string"
        }
      }
    },
    "data_boundary": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "classification",
        "phi_allowed",
        "secrets_allowed",
        "raw_evidence_allowed"
      ],
      "properties": {
        "classification": {
          "type": "string"
        },
        "phi_allowed": {
          "const": false
        },
        "secrets_allowed": {
          "const": false
        },
        "raw_evidence_allowed": {
          "const": false
        }
      }
    },
    "stage": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "id",
        "name",
        "status",
        "owner",
        "artifact_refs",
        "evidence_gap_count",
        "next_action"
      ],
      "properties": {
        "id": {
          "enum": [
            "intake",
            "patient_data_outside_ehr_map",
            "ai_phi_review",
            "vendor_baa_review",
            "access_offboarding_review",
            "downtime_ransomware_review",
            "findings_risk_register",
            "evidence_packet_export",
            "owner_msp_handoff"
          ]
        },
        "name": {
          "type": "string"
        },
        "status": {
          "enum": [
            "not_started",
            "needs_evidence",
            "ready_for_review",
            "complete"
          ]
        },
        "owner": {
          "type": "string"
        },
        "artifact_refs": {
          "type": "array",
          "minItems": 1,
          "items": {
            "type": "string"
          }
        },
        "evidence_gap_count": {
          "type": "integer",
          "minimum": 0
        },
        "next_action": {
          "type": "string"
        }
      }
    },
    "risk": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "finding_id",
        "stage_id",
        "severity",
        "priority",
        "title",
        "owner",
        "audience",
        "recipient",
        "evidence_status",
        "evidence_refs",
        "plain_english_summary",
        "why_it_matters",
        "risk_area",
        "affected_workflows",
        "owner_lane",
        "secondary_owner_lane",
        "recommended_question",
        "acceptable_evidence",
        "unsafe_inputs",
        "timeframe",
        "reviewer_needed",
        "next_action",
        "recommended_action",
        "owner_view",
        "msp_view",
        "vendor_view",
        "legal_compliance_view",
        "technical_reviewer_view",
        "output_views",
        "artifact_ref",
        "roadmap_bucket"
      ],
      "properties": {
        "finding_id": {
          "type": "string"
        },
        "stage_id": {
          "type": "string"
        },
        "severity": {
          "enum": [
            "low",
            "medium",
            "high",
            "critical"
          ]
        },
        "priority": {
          "enum": [
            "low",
            "medium",
            "high",
            "critical"
          ]
        },
        "title": {
          "type": "string"
        },
        "owner": {
          "type": "string"
        },
        "audience": {
          "type": "string"
        },
        "recipient": {
          "type": "string"
        },
        "evidence_status": {
          "enum": [
            "missing",
            "stale",
            "requested",
            "referenced"
          ]
        },
        "evidence_refs": {
          "type": "string"
        },
        "plain_english_summary": {
          "type": "string",
          "minLength": 1
        },
        "why_it_matters": {
          "type": "string",
          "minLength": 1
        },
        "risk_area": {
          "type": "string",
          "minLength": 1
        },
        "affected_workflows": {
          "type": "array",
          "minItems": 1,
          "items": {
            "type": "string"
          }
        },
        "owner_lane": {
          "$ref": "#/$defs/owner_lane"
        },
        "secondary_owner_lane": {
          "$ref": "#/$defs/owner_lane"
        },
        "recommended_question": {
          "type": "string",
          "minLength": 1
        },
        "acceptable_evidence": {
          "type": "array",
          "minItems": 1,
          "items": {
            "type": "string"
          }
        },
        "unsafe_inputs": {
          "type": "array",
          "minItems": 1,
          "items": {
            "type": "string"
          }
        },
        "timeframe": {
          "$ref": "#/$defs/timeframe"
        },
        "reviewer_needed": {
          "$ref": "#/$defs/reviewer_needed"
        },
        "next_action": {
          "type": "string",
          "minLength": 1
        },
        "recommended_action": {
          "type": "string"
        },
        "owner_view": {
          "type": "string"
        },
        "msp_view": {
          "type": "string"
        },
        "vendor_view": {
          "type": "string"
        },
        "legal_compliance_view": {
          "type": "string"
        },
        "technical_reviewer_view": {
          "type": "string"
        },
        "output_views": {
          "$ref": "#/$defs/output_views"
        },
        "artifact_ref": {
          "type": "string"
        },
        "roadmap_bucket": {
          "enum": [
            "30_days",
            "60_days",
            "90_days"
          ]
        }
      }
    },
    "evidence_gap_summary": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "total_references",
        "needs_attention",
        "by_status",
        "by_owner",
        "by_stage"
      ],
      "properties": {
        "total_references": {
          "type": "integer",
          "minimum": 0
        },
        "needs_attention": {
          "type": "integer",
          "minimum": 0
        },
        "by_status": {
          "type": "object",
          "additionalProperties": {
            "type": "integer",
            "minimum": 0
          }
        },
        "by_owner": {
          "type": "object",
          "additionalProperties": {
            "type": "integer",
            "minimum": 0
          }
        },
        "by_stage": {
          "type": "array",
          "items": {
            "type": "object",
            "additionalProperties": false,
            "required": [
              "stage_id",
              "stage_name",
              "owner",
              "evidence_gap_count",
              "recipient",
              "artifact_refs"
            ],
            "properties": {
              "stage_id": {
                "type": "string"
              },
              "stage_name": {
                "type": "string"
              },
              "owner": {
                "type": "string"
              },
              "evidence_gap_count": {
                "type": "integer",
                "minimum": 1
              },
              "recipient": {
                "type": "string"
              },
              "artifact_refs": {
                "type": "array",
                "items": {
                  "type": "string"
                }
              }
            }
          }
        }
      }
    },
    "handoff_lane": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "recipient",
        "audience",
        "actions",
        "high_priority_actions",
        "stage_ids",
        "artifact_refs"
      ],
      "properties": {
        "recipient": {
          "type": "string"
        },
        "audience": {
          "type": "string"
        },
        "actions": {
          "type": "integer",
          "minimum": 1
        },
        "high_priority_actions": {
          "type": "integer",
          "minimum": 0
        },
        "stage_ids": {
          "type": "array",
          "items": {
            "type": "string"
          }
        },
        "artifact_refs": {
          "type": "array",
          "items": {
            "type": "string"
          }
        }
      }
    },
    "offering_summary": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "name",
        "positioning",
        "audience_lanes",
        "source_anchors",
        "stage_source_map",
        "first_7_days_actions",
        "top_value_outcomes",
        "artifact_list",
        "boundary_statements",
        "escalation_triggers",
        "private_app_import"
      ],
      "properties": {
        "name": {
          "const": "Velari Cyber Readiness Sprint for Small Healthcare Practices"
        },
        "positioning": {
          "type": "string"
        },
        "audience_lanes": {
          "type": "array",
          "minItems": 4,
          "items": {
            "$ref": "#/$defs/offering_audience_lane"
          }
        },
        "source_anchors": {
          "type": "array",
          "minItems": 4,
          "items": {
            "$ref": "#/$defs/offering_source_anchor"
          }
        },
        "stage_source_map": {
          "type": "array",
          "minItems": 9,
          "maxItems": 9,
          "items": {
            "$ref": "#/$defs/offering_stage_source_map"
          }
        },
        "first_7_days_actions": {
          "type": "array",
          "minItems": 7,
          "items": {
            "$ref": "#/$defs/offering_first_week_action"
          }
        },
        "top_value_outcomes": {
          "type": "array",
          "minItems": 1,
          "items": {
            "type": "string"
          }
        },
        "artifact_list": {
          "type": "array",
          "minItems": 7,
          "items": {
            "$ref": "#/$defs/offering_artifact"
          }
        },
        "boundary_statements": {
          "type": "array",
          "minItems": 1,
          "items": {
            "type": "string"
          }
        },
        "escalation_triggers": {
          "type": "array",
          "minItems": 1,
          "items": {
            "type": "string"
          }
        },
        "private_app_import": {
          "type": "object",
          "additionalProperties": false,
          "required": [
            "contract_key",
            "import_use",
            "review_before_import"
          ],
          "properties": {
            "contract_key": {
              "const": "offering_summary"
            },
            "import_use": {
              "type": "string"
            },
            "review_before_import": {
              "const": true
            }
          }
        }
      }
    },
    "offering_audience_lane": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "id",
        "label",
        "value",
        "primary_owner",
        "primary_artifacts",
        "first_questions"
      ],
      "properties": {
        "id": {
          "enum": [
            "practice_owner",
            "msp",
            "vendor_baa_ai_reviewer",
            "legal_compliance_reviewer"
          ]
        },
        "label": {
          "type": "string"
        },
        "value": {
          "type": "string"
        },
        "primary_owner": {
          "type": "string"
        },
        "primary_artifacts": {
          "type": "array",
          "minItems": 1,
          "items": {
            "type": "string"
          }
        },
        "first_questions": {
          "type": "array",
