{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://velari.local/schemas/evidence-index.schema.json",
  "title": "Velari Sprint Mode Evidence Index",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "schema_version",
    "generated_at",
    "source_manifest",
    "data_boundary",
    "binder_export",
    "evidence_references",
    "connector_evidence"
  ],
  "properties": {
    "schema_version": {
      "const": "2026-05-19"
    },
    "generated_at": {
      "type": "string",
      "format": "date-time"
    },
    "source_manifest": {
      "const": "packet-manifest.json"
    },
    "data_boundary": {
      "$ref": "#/$defs/data_boundary"
    },
    "binder_export": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "directory",
        "artifacts",
        "share_safety"
      ],
      "properties": {
        "directory": {
          "const": "evidence-binder-export"
        },
        "artifacts": {
          "type": "array",
          "minItems": 1,
          "items": {
            "type": "string"
          }
        },
        "share_safety": {
          "const": "reference_only_no_phi_no_secret"
        }
      }
    },
    "evidence_references": {
      "type": "array",
      "items": {
        "$ref": "#/$defs/evidence_reference"
      }
    },
    "connector_evidence": {
      "type": "array",
      "items": {
        "$ref": "#/$defs/connector_evidence_item"
      }
    }
  },
  "$defs": {
    "data_boundary": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "classification",
        "phi_allowed",
        "secrets_allowed",
        "raw_evidence_allowed"
      ],
      "properties": {
        "classification": {
          "type": "string"
        },
        "phi_allowed": {
          "const": false
        },
        "secrets_allowed": {
          "const": false
        },
        "raw_evidence_allowed": {
          "const": false
        }
      }
    },
    "evidence_reference": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "evidence_id",
        "title",
        "evidence_type",
        "source_system",
        "owner",
        "status",
        "date_observed",
        "next_review_date",
        "sensitivity_boundary",
        "artifact_refs",
        "notes"
      ],
      "properties": {
        "evidence_id": {
          "type": "string"
        },
        "title": {
          "type": "string"
        },
        "evidence_type": {
          "type": "string"
        },
        "source_kind": {
          "type": "string"
        },
        "source_ref": {
          "type": "string"
        },
        "source_system": {
          "type": "string"
        },
        "owner": {
          "type": "string"
        },
        "status": {
          "enum": [
            "missing",
            "requested",
            "partial",
            "provided",
            "reviewed",
            "stale",
            "outdated",
            "blocked",
            "closed",
            "not_applicable"
          ]
        },
        "lifecycle_status": {
          "enum": [
            "missing",
            "requested",
            "partial",
            "provided",
            "reviewed",
            "stale",
            "outdated",
            "blocked",
            "closed",
            "not_applicable"
          ]
        },
        "closeout_state": {
          "enum": [
            "blocked",
            "needs_evidence",
            "ready_for_review",
            "closed",
            "not_applicable"
          ]
        },
        "date_observed": {
          "type": "string"
        },
        "next_review_date": {
          "type": "string"
        },
        "sensitivity_boundary": {
          "const": "reference_only_no_phi_no_secret"
        },
        "artifact_refs": {
          "type": "array",
          "items": {
            "type": "string"
          }
        },
        "acceptable_evidence": {
          "type": "array",
          "items": {
            "type": "string"
          }
        },
        "unsafe_inputs": {
          "type": "array",
          "items": {
            "type": "string"
          }
        },
        "next_action": {
          "type": "string"
        },
        "closeout_rule": {
          "type": "string"
        },
        "trace": {
          "type": "object",
          "additionalProperties": false,
          "required": [
            "source_kind",
            "source_ref",
            "flow_ids",
            "system_refs",
            "vendor_refs",
            "workflow_refs",
            "artifact_refs",
            "source_modules"
          ],
          "properties": {
            "source_kind": {
              "type": "string"
            },
            "source_ref": {
              "type": "string"
            },
            "flow_ids": {
              "type": "array",
              "items": {
                "type": "string"
              }
            },
            "system_refs": {
              "type": "array",
              "items": {
                "type": "string"
              }
            },
            "vendor_refs": {
              "type": "array",
              "items": {
                "type": "string"
              }
            },
            "workflow_refs": {
              "type": "array",
              "items": {
                "type": "string"
              }
            },
            "artifact_refs": {
              "type": "array",
              "items": {
                "type": "string"
              }
            },
            "source_modules": {
              "type": "array",
              "items": {
                "type": "string"
              }
            }
          }
        },
        "notes": {
          "type": "string"
        }
      }
    },
    "connector_evidence_item": {
      "type": "object",
      "additionalProperties": true,
      "required": [
        "schema_version",
        "evidence_id",
        "title",
        "plain_english_summary",
        "why_it_matters",
        "source_system",
        "source_type",
        "collected_at",
        "phi_expected",
        "phi_status",
        "control_area",
        "subject",
        "summary",
        "status",
        "confidence",
        "confidence_score",
        "confidence_reason",
        "observations",
        "owner_lane",
        "recommended_question",
        "acceptable_evidence",
        "unsafe_inputs",
        "unsafe_inputs_excluded",
        "next_action",
        "recommended_action",
        "timeframe",
        "reviewer_needed",
        "owner_view",
        "msp_view",
        "vendor_view",
        "legal_compliance_view",
        "technical_reviewer_view"
      ],
      "properties": {
        "schema_version": {
          "const": "2026-05-19"
        },
        "evidence_id": {
          "type": "string"
        },
        "title": {
          "type": "string"
        },
        "plain_english_summary": {
          "type": "string"
        },
        "why_it_matters": {
          "type": "string"
        },
        "source_system": {
          "type": "string"
        },
        "source_type": {
          "type": "string"
        },
        "collected_at": {
          "type": "string",
          "format": "date-time"
        },
        "phi_expected": {
          "const": false
        },
        "phi_status": {
          "const": "metadata_only_no_phi_expected"
        },
        "control_area": {
          "type": "string"
        },
        "subject": {
          "type": "string"
        },
        "summary": {
          "type": "string"
        },
        "status": {
          "type": "string"
        },
        "confidence": {
          "type": "string"
        },
        "confidence_score": {
          "type": "integer",
          "minimum": 0,
          "maximum": 100
        },
        "confidence_reason": {
          "type": "string"
        },
        "observations": {
          "type": "object",
          "additionalProperties": true
        },
        "owner_lane": {
          "type": "string"
        },
        "recommended_question": {
          "type": "string"
        },
        "acceptable_evidence": {
          "type": "array",
          "minItems": 1,
          "items": {
            "type": "string"
          }
        },
        "unsafe_inputs": {
          "type": "array",
          "minItems": 1,
          "items": {
            "type": "string"
          }
        },
        "unsafe_inputs_excluded": {
          "type": "array",
          "minItems": 1,
          "items": {
            "type": "string"
          }
        },
        "next_action": {
          "type": "string"
        },
        "recommended_action": {
          "type": "string"
        },
        "timeframe": {
          "type": "string"
        },
        "reviewer_needed": {
          "type": "array",
          "minItems": 1,
          "items": {
            "type": "string"
          }
        },
        "owner_view": {
          "type": "string"
        },
        "msp_view": {
          "type": "string"
        },
        "vendor_view": {
          "type": "string"
        },
        "legal_compliance_view": {
          "type": "string"
        },
        "technical_reviewer_view": {
          "type": "string"
        }
      }
    }
  }
}
