{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://velari.local/schemas/control-evidence-matrix.schema.json",
  "title": "Velari Control Evidence Matrix",
  "type": "array",
  "minItems": 1,
  "items": {
    "$ref": "#/$defs/row"
  },
  "$defs": {
    "control_family": {
      "enum": [
        "Administrative Safeguards",
        "Physical Safeguards",
        "Technical Safeguards",
        "Organizational Requirements",
        "Operational Readiness",
        "Vendor / BAA / AI"
      ]
    },
    "owner_lane": {
      "enum": [
        "owner",
        "office_manager",
        "msp",
        "vendor",
        "legal_compliance",
        "insurer",
        "clinical_lead",
        "velari_reviewer",
        "incident_responder"
      ]
    },
    "reviewer": {
      "enum": [
        "owner",
        "office_manager",
        "msp",
        "vendor",
        "legal_compliance",
        "insurer",
        "clinical_lead",
        "velari_reviewer",
        "incident_responder",
        "vendor_owner",
        "legal_or_compliance_reviewer",
        "technical_reviewer"
      ]
    },
    "evidence_status": {
      "enum": [
        "current",
        "present",
        "stale",
        "missing",
        "insufficient",
        "gated",
        "needs_owner_approval",
        "needs_professional_review",
        "not_applicable"
      ]
    },
    "freshness_status": {
      "enum": [
        "current",
        "due_soon",
        "stale",
        "missing",
        "not_applicable"
      ]
    },
    "cadence": {
      "enum": [
        "daily",
        "weekly",
        "monthly",
        "quarterly",
        "annual",
        "event_driven",
        "contract_renewal",
        "continuous"
      ]
    },
    "practice_applicability": {
      "type": "array",
      "minItems": 1,
      "items": {
        "enum": [
          "small_practice",
          "msp_supported",
          "owner_led",
          "covered_entity",
          "business_associate_supported",
          "public_demo"
        ]
      }
    },
    "string_list": {
      "type": "array",
      "minItems": 1,
      "items": {
        "type": "string",
        "minLength": 1
      }
    },
    "date_or_null": {
      "anyOf": [
        {
          "type": "string",
          "format": "date-time"
        },
        {
          "type": "string",
          "format": "date"
        },
        {
          "type": "null"
        }
      ]
    },
    "row": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "control_id",
        "control_name",
        "control_family",
        "control_refs",
        "risk_area",
        "practice_applicability",
        "evidence_id",
        "evidence_name",
        "evidence_type",
        "evidence_owner",
        "evidence_provider",
        "accountable_owner",
        "reviewer_needed",
        "evidence_status",
        "freshness_status",
        "last_collected_at",
        "last_reviewed_at",
        "effective_date",
        "cadence",
        "stale_after_days",
        "retention_years",
        "source_systems",
        "acceptable_evidence",
        "unsafe_inputs",
        "linked_answer_packet_ids",
        "next_action"
      ],
      "properties": {
        "control_id": {
          "type": "string",
          "pattern": "^VEL-[A-Z0-9-]+-[0-9]{3}$"
        },
        "control_name": {
          "type": "string",
          "minLength": 1
        },
        "control_family": {
          "$ref": "#/$defs/control_family"
        },
        "control_refs": {
          "$ref": "#/$defs/string_list"
        },
        "risk_area": {
          "type": "string",
          "minLength": 1
        },
        "practice_applicability": {
          "$ref": "#/$defs/practice_applicability"
        },
        "evidence_id": {
          "type": "string",
          "pattern": "^EV-[A-Z0-9-]+-[0-9]{3}$"
        },
        "evidence_name": {
          "type": "string",
          "minLength": 1
        },
        "evidence_type": {
          "type": "string",
          "minLength": 1
        },
        "evidence_owner": {
          "$ref": "#/$defs/owner_lane"
        },
        "evidence_provider": {
          "$ref": "#/$defs/owner_lane"
        },
        "accountable_owner": {
          "$ref": "#/$defs/owner_lane"
        },
        "reviewer_needed": {
          "type": "array",
          "minItems": 1,
          "items": {
            "$ref": "#/$defs/reviewer"
          }
        },
        "evidence_status": {
          "$ref": "#/$defs/evidence_status"
        },
        "freshness_status": {
          "$ref": "#/$defs/freshness_status"
        },
        "last_collected_at": {
          "$ref": "#/$defs/date_or_null"
        },
        "last_reviewed_at": {
          "$ref": "#/$defs/date_or_null"
        },
        "effective_date": {
          "$ref": "#/$defs/date_or_null"
        },
        "cadence": {
          "$ref": "#/$defs/cadence"
        },
        "stale_after_days": {
          "type": "integer",
          "minimum": 1
        },
        "retention_years": {
          "type": "integer",
          "minimum": 1
        },
        "source_systems": {
          "$ref": "#/$defs/string_list"
        },
        "acceptable_evidence": {
          "$ref": "#/$defs/string_list"
        },
        "unsafe_inputs": {
          "$ref": "#/$defs/string_list"
        },
        "linked_answer_packet_ids": {
          "type": "array",
          "items": {
            "type": "string",
            "minLength": 1
          }
        },
        "next_action": {
          "type": "string",
          "minLength": 1
        }
      }
    }
  }
}
